@model HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

@if (Model.Banners.Any())
{
    <div id="homeCarousel" class="carousel slide mb-4" data-bs-ride="carousel">
        <div class="carousel-inner">
            @for (var i = 0; i < Model.Banners.Count; i++)
            {
                var banner = Model.Banners[i];
                <div class="carousel-item @(i == 0 ? "active" : "")" style="height:300px;">
                    @if (!string.IsNullOrWhiteSpace(banner.ImageUrl))
                    {
                        <img src="@banner.ImageUrl" class="d-block w-100" style="height:300px;object-fit:cover;" alt="@banner.Title" />
                    }
                    else
                    {
                        <div class="d-block w-100 bg-primary text-white d-flex align-items-center justify-content-center" style="height:300px;">
                            <h2>@banner.Title</h2>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(banner.LinkUrl))
                    {
                        <a href="@banner.LinkUrl" class="carousel-caption text-decoration-none">
                            <h3>@banner.Title</h3>
                            @if (!string.IsNullOrWhiteSpace(banner.Subtitle))
                            {
                                <p>@banner.Subtitle</p>
                            }
                        </a>
                    }
                </div>
            }
        </div>
        @if (Model.Banners.Count > 1)
        {
            <button class="carousel-control-prev" type="button" data-bs-target="#homeCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#homeCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        }
    </div>
}

<div class="text-center py-4">
    <h1 class="display-4">Chào mừng đến với SalesManagement</h1>
    <p class="lead">Hệ thống quản lý bán hàng</p>
</div>

@if (Model.NewestProducts.Any())
{
    <h3 class="mb-3">Sản phẩm mới</h3>
    <div class="row">
        @foreach (var product in Model.NewestProducts)
        {
            <div class="col-md-3 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height:160px;object-fit:cover;" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@product.Name</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@product.BrandName</h6>
                        <p class="card-text fw-bold text-danger">@product.Price.ToString("N0") đ</p>
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (Model.TopRatedProducts.Any())
{
    <h3 class="mb-3 mt-4">Đánh giá cao nhất</h3>
    <div class="row">
        @foreach (var product in Model.TopRatedProducts)
        {
            <div class="col-md-3 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="text-warning">@string.Concat(Enumerable.Repeat("★", (int)Math.Round(product.AverageRating)))</p>
                        <p class="card-text fw-bold text-danger">@product.Price.ToString("N0") đ</p>
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (Model.CategorySections.Any())
{
    <h3 class="mb-3 mt-4">Sản phẩm theo danh mục</h3>
    foreach (var catSection in Model.CategorySections)
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">@catSection.Name</h5>
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@catSection.CategoryId" class="text-decoration-none">Xem tất cả</a>
        </div>
        <div class="row mb-4">
            @foreach (var product in catSection.Products)
            {
                <div class="col-md-3 mb-3">
                    <div class="card h-100">
                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height:160px;object-fit:cover;" />
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height:160px;">
                                <span class="text-muted">Không có ảnh</span>
                            </div>
                        }
                        <div class="card-body">
                            <h6 class="card-title">@product.Name</h6>
                            <p class="card-text fw-bold text-danger mb-1">@product.Price.ToString("N0") đ</p>
                            <p class="text-warning mb-2">@string.Concat(Enumerable.Repeat("★", (int)Math.Round(product.AverageRating)))</p>
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
