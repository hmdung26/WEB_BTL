@model SalesOrder
@{
    ViewData["Title"] = $"Đơn hàng #{Model.Id}";
}

<h1 class="mb-4">Đơn hàng #@Model.Id</h1>

<div class="row">
    <div class="col-md-6">
        <h5>Thông tin giao hàng</h5>
        <p class="mb-1"><strong>@Model.CustomerName</strong></p>
        <p class="mb-1">@Model.CustomerPhone</p>
        <p class="mb-1">@Model.CustomerAddress</p>
        <p class="mt-3">
            Trạng thái:
            @switch (Model.Status)
            {
                case SalesManagement.Models.Enums.OrderStatus.Pending:
                    <span class="badge bg-secondary">Chờ xử lý</span>
                    break;
                case SalesManagement.Models.Enums.OrderStatus.Processing:
                    <span class="badge bg-info">Đang xử lý</span>
                    break;
                case SalesManagement.Models.Enums.OrderStatus.Shipped:
                    <span class="badge bg-primary">Đang giao</span>
                    break;
                case SalesManagement.Models.Enums.OrderStatus.Delivered:
                    <span class="badge bg-success">Đã giao</span>
                    break;
                case SalesManagement.Models.Enums.OrderStatus.Cancelled:
                    <span class="badge bg-danger">Đã hủy</span>
                    break;
            }
        </p>
    </div>
    <div class="col-md-6">
        <h5>Thanh toán & hóa đơn</h5>
        @if (Model.Payment is not null)
        {
            <p class="mb-1">
                Phương thức:
                @switch (Model.Payment.Method)
                {
                    case SalesManagement.Models.Enums.PaymentMethod.Cod:
                        <span>COD (thanh toán khi nhận hàng)</span>
                        break;
                    case SalesManagement.Models.Enums.PaymentMethod.BankTransfer:
                        <span>Chuyển khoản ngân hàng</span>
                        break;
                    case SalesManagement.Models.Enums.PaymentMethod.EWallet:
                        <span>Ví điện tử</span>
                        break;
                }
            </p>
            <p class="mb-1">
                Trạng thái:
                @switch (Model.Payment.Status)
                {
                    case SalesManagement.Models.Enums.PaymentStatus.Pending:
                        <span class="badge bg-secondary">Chờ thanh toán</span>
                        break;
                    case SalesManagement.Models.Enums.PaymentStatus.Paid:
                        <span class="badge bg-success">Đã thanh toán</span>
                        break;
                    case SalesManagement.Models.Enums.PaymentStatus.Failed:
                        <span class="badge bg-danger">Thất bại</span>
                        break;
                    case SalesManagement.Models.Enums.PaymentStatus.Refunded:
                        <span class="badge bg-warning text-dark">Đã hoàn tiền</span>
                        break;
                }
            </p>
            @if (!string.IsNullOrWhiteSpace(Model.Payment.TransactionCode))
            {
                <p class="mb-1">Mã giao dịch: @Model.Payment.TransactionCode</p>
            }
        }
        else
        {
            <p class="text-muted">Chưa có thanh toán.</p>
        }
        @if (Model.Invoice is not null)
        {
            <p class="mb-1">Hóa đơn: @Model.Invoice.InvoiceNumber</p>
        }
        @if (Model.Promotion is not null)
        {
            <p class="mb-1">Mã giảm giá: @Model.Promotion.Code</p>
        }
    </div>
</div>

<h5 class="mt-4">Sản phẩm</h5>
<table class="table">
    <thead>
        <tr><th>Sản phẩm</th><th>Đơn giá</th><th>SL</th><th>Thành tiền</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderItems)
        {
            <tr>
                <td>@item.Product.Name</td>
                <td>@item.Price.ToString("N0") đ</td>
                <td>@item.Quantity</td>
                <td>@item.SubTotal.ToString("N0") đ</td>
            </tr>
        }
    </tbody>
</table>

<div class="text-end">
    <p>Tạm tính: <strong>@Model.SubTotal.ToString("N0") đ</strong></p>
    @if (Model.DiscountAmount > 0)
    {
        <p class="text-success">Giảm giá: <strong>-@Model.DiscountAmount.ToString("N0") đ</strong></p>
    }
    <h4>Tổng cộng: <span class="text-danger">@Model.TotalAmount.ToString("N0") đ</span></h4>
</div>

<a asp-action="My" class="btn btn-secondary">Quay lại</a>
