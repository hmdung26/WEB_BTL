@model CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<h1 class="mb-4">Giỏ hàng</h1>

@if (TempData["StatusMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

@if (Model.Items.Count == 0)
{
    <p class="text-muted">Giỏ hàng của bạn đang trống.</p>
    <a asp-controller="Product" asp-action="Index" class="btn btn-primary">Tiếp tục mua sắm</a>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Đơn giá</th>
                <th style="width:160px;">Số lượng</th>
                <th>Thành tiền</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" style="width:50px;height:50px;object-fit:cover;" class="me-2" />
                            }
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId">@item.Name</a>
                        </div>
                    </td>
                    <td>@item.Price.ToString("N0") đ</td>
                    <td>
                        <form asp-action="Update" method="post" class="d-flex">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm me-1" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Cập nhật</button>
                        </form>
                    </td>
                    <td>@item.SubTotal.ToString("N0") đ</td>
                    <td>
                        <form asp-action="Remove" method="post">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="row">
        <div class="col-md-6">
            @if (!Model.PromoApplied)
            {
                <form asp-action="ApplyPromotion" method="post" class="d-flex mb-3">
                    <input type="text" name="code" value="@Model.PromoCode" class="form-control me-2" placeholder="Nhập mã giảm giá" />
                    <button type="submit" class="btn btn-outline-primary">Áp dụng</button>
                </form>
                @if (!string.IsNullOrWhiteSpace(Model.PromoMessage))
                {
                    <div class="text-danger">@Model.PromoMessage</div>
                }
            }
            else
            {
                <div class="mb-3">
                    <span class="badge bg-success">@Model.PromoCode</span>
                    <span class="text-success ms-2">@Model.PromoMessage</span>
                    <form asp-action="RemovePromotion" method="post" class="d-inline ms-2">
                        <button type="submit" class="btn btn-sm btn-link">Bỏ mã</button>
                    </form>
                </div>
            }
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <p class="mb-1">Tạm tính: <strong>@Model.SubTotal.ToString("N0") đ</strong></p>
                    @if (Model.PromoApplied)
                    {
                        <p class="mb-1 text-success">Giảm giá: <strong>-@Model.DiscountAmount.ToString("N0") đ</strong></p>
                    }
                    <h4 class="mt-2">Tổng cộng: <span class="text-danger">@Model.Total.ToString("N0") đ</span></h4>
                    <a asp-controller="Order" asp-action="Checkout" class="btn btn-primary w-100">Tiến hành đặt hàng</a>
                    <form asp-action="Clear" method="post" class="mt-2">
                        <button type="submit" class="btn btn-link text-danger w-100">Xóa giỏ hàng</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
