@{
    ViewData["Title"] = "Quản trị";
    Layout = "_AdminLayout";
}

<div class="py-3">
    <h1 class="mb-4">Trang quản trị</h1>
    <p class="text-muted">Khu vực quản trị dành cho nhân viên (Staff) và quản trị viên (Admin).</p>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Sản phẩm & danh mục</h5>
                    <ul class="list-unstyled mb-0">
                        <li><a asp-controller="Product" asp-action="Manage">Quản lý sản phẩm</a></li>
                        <li><a asp-controller="Category" asp-action="Index">Quản lý danh mục</a></li>
                        <li><a asp-controller="Brand" asp-action="Index">Quản lý thương hiệu</a></li>
                        <li><a asp-controller="Banner" asp-action="Index">Quản lý banner</a></li>
                        <li><a asp-controller="Promotion" asp-action="Index">Quản lý khuyến mãi</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Bán hàng & vận hành</h5>
                    <ul class="list-unstyled mb-0">
                        <li><a asp-controller="Order" asp-action="Index">Quản lý đơn hàng</a></li>
                        <li><a asp-controller="Payment" asp-action="Index">Quản lý thanh toán</a></li>
                        <li><a asp-controller="Warehouse" asp-action="Index">Quản lý kho</a></li>
                        <li><a asp-controller="Warranty" asp-action="Index">Quản lý bảo hành</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Người dùng</h5>
                    <ul class="list-unstyled mb-0">
                        <li><a asp-controller="AdminUser" asp-action="Index">Quản lý người dùng</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
