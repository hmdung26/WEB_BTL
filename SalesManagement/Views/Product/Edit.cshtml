@model ProductFormViewModel
@{
    ViewData["Title"] = "Sửa sản phẩm";
    Layout = "_AdminLayout";
}

<h1 class="mb-4">Sửa sản phẩm</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="Specifications" class="form-label"></label>
                <textarea asp-for="Specifications" class="form-control" rows="3"></textarea>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Price" class="form-label"></label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="StockQuantity" class="form-label"></label>
                    <input asp-for="StockQuantity" class="form-control" />
                    <span asp-validation-for="StockQuantity" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="WarrantyPeriod" class="form-label"></label>
                <input asp-for="WarrantyPeriod" class="form-control" />
                <span asp-validation-for="WarrantyPeriod" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="BrandId" class="form-label"></label>
                <select asp-for="BrandId" class="form-select" asp-items="Model.BrandOptions"></select>
                <span asp-validation-for="BrandId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" class="form-select" asp-items="Model.CategoryOptions"></select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ImageUrl" class="form-label"></label>
                <input asp-for="ImageUrl" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="ImageFile" class="form-label"></label>
                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
            </div>
            <div class="mb-3">
                <label asp-for="ImageFiles" class="form-label"></label>
                <input asp-for="ImageFiles" type="file" class="form-control" accept="image/*" multiple />
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>

@if (Model.ExistingImages.Any())
{
    <h5 class="mt-4">Ảnh sản phẩm hiện tại</h5>
    <div class="row mb-4">
        @foreach (var image in Model.ExistingImages)
        {
            <div class="col-md-2 mb-3">
                <img src="@image.ImageUrl" class="img-thumbnail" style="height:100px;object-fit:cover;" />
                <form asp-action="DeleteImage" method="post" class="mt-1">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="imageId" value="@image.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-danger w-100" onclick="return confirm('Xóa ảnh này?')">Xóa</button>
                </form>
            </div>
        }
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
