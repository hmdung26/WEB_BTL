@model IEnumerable<Product>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
    Layout = "_AdminLayout";
}

<h1 class="mb-3">Quản lý sản phẩm</h1>

@if (TempData["StatusMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<p>
    <a asp-action="Create" class="btn btn-success">+ Thêm sản phẩm</a>
</p>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Ảnh</th>
            <th>Tên</th>
            <th>Thương hiệu</th>
            <th>Danh mục</th>
            <th class="text-end">Giá</th>
            <th class="text-end">Tồn kho</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" style="height:40px;width:40px;object-fit:cover;" alt="@product.Name" />
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td>@product.Name</td>
                <td>@product.Brand.Name</td>
                <td>@product.Category.Name</td>
                <td class="text-end">@product.Price.ToString("N0") đ</td>
                <td class="text-end">@product.StockQuantity</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                    <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa sản phẩm này?')">Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">Chưa có sản phẩm nào.</p>
}
