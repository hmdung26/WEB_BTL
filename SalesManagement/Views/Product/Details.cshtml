@model ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
}

@if (TempData["StatusMessage"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-6">
        @if (Model.ImageUrls.Any())
        {
            <div id="productCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @for (var i = 0; i < Model.ImageUrls.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@Model.ImageUrls[i]" class="d-block w-100" alt="@Model.Name" style="height:400px;object-fit:cover;" />
                        </div>
                    }
                </div>
                @if (Model.ImageUrls.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                }
            </div>
        }
        else
        {
            <div class="bg-light d-flex align-items-center justify-content-center" style="height:400px;">
                <span class="text-muted">Không có ảnh</span>
            </div>
        }
    </div>
    <div class="col-md-6">
        <h1>@Model.Name</h1>
        <p class="text-muted mb-2">Thương hiệu: @Model.BrandName · Danh mục: @Model.CategoryName</p>
        <h2 class="text-danger mb-3">@Model.Price.ToString("N0") đ</h2>

        <p class="mb-2">
            <span class="text-warning fs-5">@string.Concat(Enumerable.Repeat("★", (int)Math.Round(Model.AverageRating)))</span>
            <span class="text-muted">@Model.AverageRating.ToString("0.0") / 5 (@Model.ReviewCount đánh giá)</span>
        </p>

        <p class="mb-2">
            @if (Model.StockQuantity > 0)
            {
                <span class="badge bg-success">Còn hàng (@Model.StockQuantity)</span>
            }
            else
            {
                <span class="badge bg-secondary">Hết hàng</span>
            }
            <span class="badge bg-info">Bảo hành @Model.WarrantyPeriod tháng</span>
        </p>

        @if (Model.StockQuantity > 0)
        {
            <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex align-items-center gap-2 mt-3">
                <input type="hidden" name="productId" value="@Model.Id" />
                <input type="number" name="quantity" value="1" min="1" max="@Model.StockQuantity" class="form-control" style="max-width:80px;" />
                <button type="submit" class="btn btn-primary">Thêm vào giỏ hàng</button>
            </form>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <h5 class="mt-4">Mô tả</h5>
            <p>@Model.Description</p>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Specifications))
        {
            <h5>Thông số kỹ thuật</h5>
            <pre class="border p-3 bg-light" style="white-space:pre-wrap;">@Model.Specifications</pre>
        }
    </div>
</div>

<hr class="my-5" />

<div class="row">
    <div class="col-md-8">
        <h3>Đánh giá sản phẩm (@Model.ReviewCount)</h3>

        @if (User.Identity?.IsAuthenticated == true)
        {
            @if (Model.CanReview)
            {
                <div class="card mb-4">
                    <div class="card-body">
                        <h5>Viết đánh giá</h5>
                        <form asp-action="Review" method="post">
                            <input type="hidden" name="ProductId" value="@Model.Id" />
                            <div class="mb-3">
                                <label class="form-label">Số sao</label>
                                <select name="Rating" class="form-select" style="max-width:200px;">
                                    <option value="5">5 - Tuyệt vời</option>
                                    <option value="4">4 - Tốt</option>
                                    <option value="3">3 - Bình thường</option>
                                    <option value="2">2 - Kém</option>
                                    <option value="1">1 - Rất kém</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Bình luận</label>
                                <textarea name="Comment" class="form-control" rows="3"></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary">Gửi đánh giá</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <p class="text-muted">Bạn chỉ có thể đánh giá sau khi mua và nhận hàng.</p>
            }
        }
        else
        {
            <p class="text-muted"><a asp-controller="Account" asp-action="Login">Đăng nhập</a> để đánh giá sản phẩm.</p>
        }

        @if (Model.Reviews.Any())
        {
            @foreach (var review in Model.Reviews)
            {
                <div class="border rounded p-3 mb-3">
                    <div class="d-flex justify-content-between">
                        <div>
                            <strong>@review.UserName</strong>
                            <span class="text-warning ms-2">@string.Concat(Enumerable.Repeat("★", review.Rating))</span>
                        </div>
                        <small class="text-muted">@review.CreatedAt.ToString("dd/MM/yyyy")</small>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(review.Comment))
                    {
                        <p class="mb-1 mt-2">@review.Comment</p>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <form asp-controller="ProductReview" asp-action="Delete" method="post" class="mt-2">
                            <input type="hidden" name="id" value="@review.Id" />
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa đánh giá này?')">Xóa</button>
                        </form>
                    }
                </div>
            }
        }
        else
        {
            <p class="text-muted">Chưa có đánh giá nào.</p>
        }
    </div>
</div>

@if (User.IsInRole("Admin"))
{
    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">Sửa sản phẩm</a>
    </div>
}
