@model WarrantyLookupViewModel
@using SalesManagement.Models.Enums
@{
    ViewData["Title"] = "Tra cứu bảo hành";
}

<h1 class="mb-4">Tra cứu bảo hành</h1>

<form asp-action="Lookup" method="post" class="row g-2 align-items-end mb-4">
    <div class="col-md-6">
        <label asp-for="SerialNumber" class="form-label"></label>
        <input asp-for="SerialNumber" class="form-control" placeholder="Nhập số serial..." />
        <span asp-validation-for="SerialNumber" class="text-danger"></span>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Tra cứu</button>
    </div>
    <div class="col-md-4 text-md-end">
        <a asp-action="Submit" class="btn btn-outline-primary">Gửi yêu cầu bảo hành</a>
    </div>
</form>

@if (Model.Warranty is not null)
{
    <div class="card mb-4">
        <div class="card-header"><strong>Kết quả tra cứu</strong></div>
        <div class="card-body">
            <p class="mb-1"><strong>Số serial:</strong> @Model.Warranty.SerialNumber</p>
            <p class="mb-1">
                <strong>Sản phẩm:</strong>
                @(Model.Warranty.WarehouseItem?.Product.Name ?? Model.Warranty.OrderItem?.Product.Name ?? "—")
            </p>
            <p class="mb-1"><strong>Thời hạn bảo hành:</strong> @Model.Warranty.StartDate.ToString("dd/MM/yyyy") - @Model.Warranty.EndDate.ToString("dd/MM/yyyy")</p>
            <p class="mb-1">
                <strong>Trạng thái:</strong>
                <span class="badge bg-info">@Model.Warranty.Status</span>
            </p>
            @if (!string.IsNullOrWhiteSpace(Model.Warranty.Note))
            {
                <p class="mb-1"><strong>Ghi chú:</strong> @Model.Warranty.Note</p>
            }
        </div>
    </div>

    <h5 class="mb-3">Lịch sử xử lý</h5>
    @if (Model.History.Count == 0)
    {
        <p class="text-muted">Chưa có cập nhật nào.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr><th>Thời gian</th><th>Trạng thái</th><th>Ghi chú</th></tr>
            </thead>
            <tbody>
                @foreach (var h in Model.History)
                {
                    <tr>
                        <td>@h.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@h.Status</td>
                        <td>@(h.Note ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
else if (!string.IsNullOrWhiteSpace(Model.SerialNumber))
{
    <div class="alert alert-warning">
        Không tìm thấy hồ sơ bảo hành cho serial <strong>@Model.SerialNumber</strong>.
        @if (Model.WarehouseItem is not null)
        {
            <span>Mặt hàng này hiện ở trạng thái: <strong>@Model.WarehouseItem.Status</strong>.</span>
        }
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="mt-2">
                <a asp-action="Submit" class="btn btn-sm btn-outline-primary">Gửi yêu cầu bảo hành cho sản phẩm này</a>
            </div>
        }
    </div>
}
