@model IEnumerable<Payment>
@using SalesManagement.Models.Enums
@{
    ViewData["Title"] = "Quản lý thanh toán";
    Layout = "_AdminLayout";
}

<h1 class="mb-4">Quản lý thanh toán</h1>

@if (TempData["StatusMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Đơn hàng</th>
            <th>Phương thức</th>
            <th>Số tiền</th>
            <th>Trạng thái</th>
            <th>Mã giao dịch</th>
            <th>Thời gian thanh toán</th>
            <th>Cập nhật trạng thái</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var payment in Model)
        {
            <tr>
                <td>#@payment.Order.Id</td>
                <td>
                    @switch (payment.Method)
                    {
                        case PaymentMethod.Cod:
                            <span>COD</span>
                            break;
                        case PaymentMethod.BankTransfer:
                            <span>Chuyển khoản</span>
                            break;
                        case PaymentMethod.EWallet:
                            <span>Ví điện tử</span>
                            break;
                    }
                </td>
                <td>@payment.Amount.ToString("N0") đ</td>
                <td>
                    @switch (payment.Status)
                    {
                        case PaymentStatus.Pending:
                            <span class="badge bg-secondary">Chờ thanh toán</span>
                            break;
                        case PaymentStatus.Paid:
                            <span class="badge bg-success">Đã thanh toán</span>
                            break;
                        case PaymentStatus.Failed:
                            <span class="badge bg-danger">Thất bại</span>
                            break;
                        case PaymentStatus.Refunded:
                            <span class="badge bg-warning text-dark">Đã hoàn tiền</span>
                            break;
                    }
                </td>
                <td>
                    <form asp-action="AttachTransaction" method="post" class="d-flex gap-1">
                        <input type="hidden" name="id" value="@payment.Id" />
                        <input type="text" name="transactionCode" value="@payment.TransactionCode" class="form-control form-control-sm" style="max-width:160px;" placeholder="Mã giao dịch" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Lưu</button>
                    </form>
                </td>
                <td>@(payment.PaidAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                <td>
                    <form asp-action="UpdateStatus" method="post" class="d-flex gap-1">
                        <input type="hidden" name="id" value="@payment.Id" />
                        <select name="status" class="form-select form-select-sm" style="max-width:150px;">
                            @foreach (var s in Enum.GetValues<PaymentStatus>())
                            {
                                <option value="@s" selected="@(s == payment.Status)">@s</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-primary">Cập nhật</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
